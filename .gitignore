# Live eval reports are committed deliberately, after a real reviewed run (a blocked or dry run
# would otherwise leave a report that reads like a model-quality result).
scripts/evals/reports/live-*

node_modules/

# Local env files hold API keys (ANTHROPIC_API_KEY, TMDB, IGDB); never commit them (#218).
.env
.env.*
!.env.example

# Stress-eval (#28) run output: JSONL from paid runs lives in workflow artifacts, not in git.
scripts/evals/stress/results/

# #341 step 2: eval run reports (committed references are replaced only with --update-baseline)
scripts/evals/reports/runs/

# #341 step 2 (PR B): correction eval reports (offline, regenerated on demand; nothing committed)
scripts/evals/corrections/reports/
